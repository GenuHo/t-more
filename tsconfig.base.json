{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2018",
    "module": "esnext",
    "baseUrl": ".",
    "sourceMap": false,
    "moduleResolution": "node",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "rootDir": ".",
    "types": [],
    "paths": {
      "@tailor-more/t-more-components": ["packages/components"],
      "@tailor-more/t-more-utils": ["packages/utils"],
      "@tailor-more/t-more-hooks": ["packages/hooks"],
      "@tailor-more/t-more-directives": ["packages/directives"],
      "@tailor-more/t-more-constants": ["packages/constants"],
      "@tailor-more/t-more-locale": ["packages/locale"],
      "@tailor-more/t-more": ["packages/t-more"]
    },
    "preserveSymlinks": true
  }
}
